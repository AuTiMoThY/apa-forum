# ============================================
# Docker 環境配置範例
# ============================================
# 複製此檔案為 .env 並修改相應的值

# 應用環境
NODE_ENV=development
CI_ENVIRONMENT=development

# 端口配置
FRONTEND_PORT=8090
ADMIN_PORT=8091
API_PORT=8092
PHPMYADMIN_PORT=8093
MYSQL_PORT=3306

# 前端配置
NUXT_PUBLIC_API_BASE=http://localhost:8092

# 後端配置
APP_BASE_URL=http://localhost:8092

# 資料庫配置
# 注意： MYSQL_USER 不能是 "root"，必須是普通用戶名稱
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=manthiri
MYSQL_USER=manthiri
MYSQL_PASSWORD=22461711

# 資料庫連線（後端使用）
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=manthiri
DB_USERNAME=root
DB_PASSWORD=22461711
